{
  "name": "captioneer",
  "version": "1.0.0",
  "description": "Production-ready automated video captioning & subtitle burn-in backend powered by Node.js, Express, FFmpeg, and Groq Cloud Whisper API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/test-pipeline.js && node test/test-api.js"
  },
  "keywords": [
    "video-captioning",
    "groq",
    "whisper",
    "whisper-large-v3",
    "ffmpeg",
    "subtitles",
    "srt",
    "vtt",
    "express"
  ],
  "author": "Mudassir",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "groq-sdk": "^0.15.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "node-fetch": "^3.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
